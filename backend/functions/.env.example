# Copiar a .env.<PROJECT_ID> después de aprobar región y crear proyectos.
# Sin secretos. Los valores aquí son DEMO y NO habilitan despliegue.
LAZO_ENV=dev
LAZO_VERSION=0.1.0
LAZO_REGION=europe-west1
LAZO_SYSTEM_SERVICE_ACCOUNT=lazo-system@demo-lazo.iam.gserviceaccount.com
LAZO_WORKER_SERVICE_ACCOUNT=lazo-worker@demo-lazo.iam.gserviceaccount.com
# Secret Manager: LAZO_INTEGRATION_SECRET (declarado, sin consumidor en Paso 1).
# Nunca guardar aquí claves de proveedores ni credenciales de cuentas de servicio.
