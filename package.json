{
  "name": "lazo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "workspaces": ["backend/functions"],
  "scripts": {
    "build": "npm run build --workspace @lazo/functions",
    "lint": "npm run lint --workspace @lazo/functions",
    "test": "npm run test --workspace @lazo/functions",
    "test:rules": "node --test backend/firestore/tests/*.test.mjs",
    "test:scripts": "node --test backend/scripts/tests/*.test.mjs",
    "test:emulator:inner": "npm run test:emulator --workspace @lazo/functions && npm run test:rules && npm run smoke:emulator && node backend/scripts/test-seed.mjs",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-lazo --only auth,firestore,functions,storage \"npm run test:emulator:inner\"",
    "emulators": "node backend/scripts/start-emulators.mjs",
    "seed:demo": "tsx backend/scripts/seed-demo.ts",
    "smoke:emulator": "node backend/scripts/smoke-ping.mjs --emulator",
    "deploy:checked": "node backend/scripts/deploy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1",
    "tsx": "4.23.15"
  }
}
